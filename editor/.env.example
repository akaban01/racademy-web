# Copy to .env for local dev (`npm run dev` in this directory), and set the
# same values in the Netlify dashboard for the editor's site (Site
# configuration -> Environment variables) for production.

# GitHub OAuth App (register at github.com/settings/developers). Callback
# URL must be https://<editor-subdomain>/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Same Client ID as above, exposed to the browser bundle (Vite only
# inlines VITE_-prefixed vars). Non-secret.
VITE_GITHUB_OAUTH_CLIENT_ID=

# Repo the editor is allowed to read/write, and the branch Netlify
# auto-deploys from.
GITHUB_ALLOWED_REPO=akaban01/racademy-web
VITE_GITHUB_ALLOWED_REPO=akaban01/racademy-web
GITHUB_DEPLOY_BRANCH=master
VITE_GITHUB_DEPLOY_BRANCH=master
